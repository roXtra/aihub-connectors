{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.PersistentFile" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "PersistentFile",
        "Args": {
          "path": "Logs/roXtraAiHubConnector.log",
          "retainedFileCountLimit": 10,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "AiHub.Connector" }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5254"
      }
    }
  },
  "AllowedHosts": "*",
  "Webhooks": {
    "ApiKey": ""
  },
  "Roxtra": {
    "RoxtraUrl": "https://your-roxtra.example.com"
  },
  "ConnectionStrings": {
    "Default": "Data Source=connector.db"
  },
  "OpenAI": {
    "ApiKey": "your-open-ai-key",
    "VectorStoreNamePrefix": "roXtra-aihub",
    "ChunkingStrategy": "static",
    "MaxChunkSizeTokens": 800,
    "ChunkOverlapTokens": 400
  }
}
